{
  "name": "xa-web",
  "version": "0.1.0",
  "private": true,
  "description": "基于 Ant Design Pro v6.0.3 的 xa Agent 管理端",
  "scripts": {
    "dev": "cross-env HOST=127.0.0.1 PORT=8000 max dev",
    "start": "npm run dev",
    "build": "max build",
    "prepare": "max setup",
    "lint": "biome check && tsc --noEmit",
    "format": "biome check --write",
    "tsc": "tsc --noEmit",
    "test": "playwright test",
    "lint:antd": "antd lint ./src --format json"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/pro-components": "^3.1.14-2",
    "antd": "^6.6.0",
    "antd-style": "^4.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.6.0",
    "@biomejs/biome": "^2.5.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@umijs/max": "^4.7.3",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@umijs/plugins": {
      "@ant-design/pro-components": "$@ant-design/pro-components"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
