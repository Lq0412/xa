# 本地开发配置。执行 bash scripts/init-env.sh 生成带随机凭证的 .env。
XA_HTTP_SERVER_ADDRESS=127.0.0.1:18080
XA_HTTP_WORKER_ADDRESS=127.0.0.1:18081
XA_STARTUP_TIMEOUT=15s
XA_SHUTDOWN_TIMEOUT=10s
XA_HEALTH_TIMEOUT=3s

# 阿里百炼 OpenAI 兼容接口（启动 server 必填）
# XA_BAILIAN_API_KEY=
XA_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
XA_CHAT_MODEL=qwen3.7-plus
XA_LIGHT_MODEL=qwen3.8-flash

# 可选：首次启动时初始化平台管理员。两项必须同时设置，已有管理员会更新密码摘要。
# XA_ADMIN_EMAIL=admin@example.com
# XA_ADMIN_PASSWORD=

XA_POSTGRES_HOST=127.0.0.1
XA_POSTGRES_PORT=15432
XA_POSTGRES_DATABASE=xa
XA_POSTGRES_USER=xa
XA_POSTGRES_SSL_MODE=disable

XA_REDIS_ADDRESS=127.0.0.1:16379
XA_REDIS_PORT=16379

XA_S3_ENDPOINT=127.0.0.1:19000
XA_S3_PORT=19000
XA_S3_CONSOLE_PORT=19001
XA_S3_BUCKET=xa-files
XA_S3_REGION=us-east-1
XA_S3_SECURE=false

# 必填凭证由初始化脚本生成；手动配置时添加以下变量，禁止提交实际值。
# XA_POSTGRES_PASSWORD=
# XA_REDIS_PASSWORD=
# XA_S3_ACCESS_KEY=
# XA_S3_SECRET_KEY=
